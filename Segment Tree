class SGTree{
    public :
    vector<int>seg;

    

    SGTree(int n){
        seg.resize(4*n+1);
    }
    void build(vector<int>&v, int idx , int low , int high){
    if(low == high){
        seg[idx] = v[low];
        return; 
    }
    int mid = (low+high)/2;

    build(v,2*idx+1,low,mid);
    build(v,2*idx+2,mid+1,high);

    seg[idx] = min(seg[2*idx+1] , seg[2*idx+2]);

    


}

int query( int l , int r , int low , int high , int idx){
    if(r<low || high <l) return INT_MAX;

    if(l<=low && high<=r){
        return seg[idx];
    }
        int mid = (low+high)/2;
        int left = query(l,r,low,mid,2*idx+1);
        int right = query(l,r,mid+1,high,2*idx+2);

        return min(left,right);
    
}

void update( int idx , int low , int high , int i , int val){
    if(low ==high){
        seg[idx] = val;
        return;
    }

    int mid = (low + high)/2;

    if(i<=mid){
        update(2*idx+1,low,mid,i,val);
    }else{
        update(2*idx+2,mid+1,high,i,val);
    }

    seg[idx] = min(seg[2*idx+1],seg[2*idx+2]);
}
};
