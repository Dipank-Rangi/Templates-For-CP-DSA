#include <algorithm>
using namespace std;
typedef long long ll;


class SGTree{
    public :
    vector<int>seg,lazy;

    

    SGTree(int n){
        seg.resize(4*n+1);
        lazy.resize(4*n+1,0);
    }
    void build(vector<int>&v, int idx , int low , int high){
    if(low == high){
        seg[idx] = v[low];
        return; 
    }
    int mid = (low+high)>>1;

    build(v,2*idx+1,low,mid);
    build(v,2*idx+2,mid+1,high);

    seg[idx] = min(seg[2*idx+1] , seg[2*idx+2]);

    


}

int query( int l , int r , int low , int high , int idx){

    if(lazy[idx]!=0){
        seg[idx] +=lazy[idx];
    // propagate lazy updates downwards
    if(low!=high){
        lazy[2*idx+1]+=lazy[idx];
        lazy[2*idx+2]+=lazy[idx];
    }

    lazy[idx] = 0;
    }
    if(r<low || high <l) return INT_MAX;

    if(l<=low && high<=r){
        return seg[idx];
    }
        int mid = (low+high)/2;
        int left = query(l,r,low,mid,2*idx+1);
        int right = query(l,r,mid+1,high,2*idx+2);

        return min(left,right);
    
}

void update( int idx , int low , int high , int l , int r , int val){
   // update previous remianing updates

   if(lazy[idx] != 0){
    seg[idx] +=lazy[idx];
    // propagate lazy updates downwards
    if(low!=high){
        lazy[2*idx+1]+=lazy[idx];
        lazy[2*idx+2]+=lazy[idx];
    }

    lazy[idx] = 0;

   }

   if(r<low || l>high){
    return ;
   }

   if(l<=low && high<=r){
    seg[idx]=(seg[idx])+val;
    // low!=high means it have child nodes
    if(low!=high){
        lazy[2*idx+1]+=val;
        lazy[2*idx+2]+=val;
    }
    return;
   }

   int mid = low + ((high-low)>>1);
   update(2*idx+1,low,mid,l,r,val);
   update(2*idx+2,mid+1,high,l,r,val);

    seg[idx] = min(seg[2*idx+1],seg[2*idx+2]);
}
};
void solve(){
    int n ; cin>>n;
    vector<int> v(n);
    for(auto & it : v) cin>>it;
    SGTree sg1(n);
    sg1.build(v,0,0,n-1);
    

  

    int q;cin>>q;

    while(q--){
        int type;
        cin>>type;
        if(type==1){
        int l , r;
        cin>>l>>r;
        cout<<sg1.query(l,r,0,n-1,0)<<endl;
        }else{
            int l,r , val;
            cin>>l>>r>>val;
            
            sg1.update(0,0,n-1,l,r,val);
            
        }
    }

}
int main() {
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    solve();


    return 0;
}
